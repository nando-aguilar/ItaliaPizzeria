<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.italia.pizza.controllers.ProductosController"
            style="-fx-background-color: #ffffff;">

    <left>
        <VBox prefWidth="220" spacing="20" style="-fx-background-color: #1e1e1e;">
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <VBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="80" fitWidth="80" onMouseClicked="#volverAlMenu" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@../images/pizza_logo.png"/>
                    </image>
                </ImageView>
                <Label text="ITALIA PIZZERIA"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="10">
                <Label fx:id="lblAdministracion" text="Administración" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnUsuarios" text="Usuarios" onAction="#openUsuarios"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Inventarios" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                
                <Button text="Productos" onAction="#openProductos"
                        style="-fx-background-color: #333333; -fx-text-fill: white; -fx-font-size: 14px;"/>
                
                <Button text="Validación" onAction="#openValidacion"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Pedidos" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button text="Pedidos" onAction="#openPedidos"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Ayuda" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button text="Acerca de" onAction="#openAyuda"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Cerrar sesión" onAction="#logout"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 6 12; -fx-background-radius: 5;"/>
            </VBox>

            <Label fx:id="lblUsuario" text="Usuario"
                   style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #ffffff;">

            <Label text="Productos"
                   style="-fx-text-fill: black; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar producto..."
                           style="-fx-font-size: 14px; -fx-padding: 8;"/>
                <Button text="Buscar" onAction="#buscarProducto"
                        style="-fx-background-color: #007bff; -fx-text-fill: white;
                               -fx-padding: 8 20; -fx-background-radius: 5;"/>
                
                <Button fx:id="btnRegistrar" text="Registrar nuevo" onAction="#registrarProducto"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;
                               -fx-padding: 8 20; -fx-background-radius: 5;"/>
                <Button fx:id="btnEditar" text="Editar" onAction="#editarProducto"
                        style="-fx-background-color: #ffc107; -fx-text-fill: black;
                               -fx-padding: 8 20; -fx-background-radius: 5;"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarProducto"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white;
                               -fx-padding: 8 20; -fx-background-radius: 5;"/>
            </HBox>

            <TableView fx:id="tablaProductos" prefHeight="400">
                <columns>
                    <TableColumn text="Código"      prefWidth="120"/>
                    <TableColumn text="Nombre"      prefWidth="200"/>
                    <TableColumn text="Descripción" prefWidth="200"/>
                    <TableColumn text="Precio"      prefWidth="100"/>
                    <TableColumn text="Cantidad"    prefWidth="100"/>
                    <TableColumn text="Estatus"     prefWidth="120"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>