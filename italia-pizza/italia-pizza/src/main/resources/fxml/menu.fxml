<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.italia.pizza.controllers.MenuController"
            style="-fx-background-color: #ffffff;">

    <left>
        <VBox prefWidth="220" spacing="20" style="-fx-background-color: #1e1e1e;">
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <VBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="80" fitWidth="80" onMouseClicked="#volverAlMenu" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@../images/pizza_logo.png"/>
                    </image>
                </ImageView>
                <Label text="ITALIA PIZZERIA"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="10">
                <Label fx:id="lblAdministracion" text="Administración" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnUsuarios" text="Usuarios" onAction="#openUsuarios"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Inventarios" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnProductos" text="Productos" onAction="#openProductos"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>
                <Button fx:id="btnValidacion" text="Validación" onAction="#openValidacion"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Pedidos" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnPedidos" text="Pedidos" onAction="#openPedidos"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Ayuda" style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnAyuda" text="Acerca de" onAction="#openAyuda"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Cerrar sesión" onAction="#logout"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 6 12; -fx-background-radius: 5;"/>
            </VBox>

            <Label fx:id="lblUsuario" text="Usuario"
                   style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane prefHeight="600" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    style="-fx-background-color: #ffffff; -fx-border-color: transparent;">
            
            <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: #ffffff;" prefWidth="780">
                
                <Label text="Panel Principal - Vistas del Sistema"
                       style="-fx-text-fill: black; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 10;">
                    <StackPane style="-fx-background-color: white; 
                                      -fx-background-radius: 15; 
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <ImageView fitWidth="500" preserveRatio="true">
                            <image><Image url="@../images/pizza_menu.png"/></image>
                        </ImageView>
                    </StackPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="Inventario de Productos Activos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tablaVistaProductos" prefHeight="200"/>
                </VBox>

                <VBox spacing="10">
                    <Label text="Información General de Pedidos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tablaVistaPedidos" prefHeight="200"/>
                </VBox>

                <VBox spacing="10">
                    <Label text="Desglose de Artículos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tablaVistaDetalles" prefHeight="200"/>
                </VBox>
                
                <VBox spacing="10">
                    <Label text="Usuarios Registrados Recientemente" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="tablaVistaUsuariosRecientes" prefHeight="200"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>