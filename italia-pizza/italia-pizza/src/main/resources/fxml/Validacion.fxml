<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.italia.pizza.controllers.ValidacionController"
            style="-fx-background-color: #ffffff;">

    <left>
        <VBox prefWidth="220" spacing="20" style="-fx-background-color: #1e1e1e;">
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <VBox alignment="CENTER" spacing="10">
                <ImageView fitHeight="80" fitWidth="80" onMouseClicked="#volverAlMenu" style="-fx-cursor: hand;">
                    <image><Image url="@../images/pizza_logo.png"/></image>
                </ImageView>
                <Label text="ITALIA PIZZERIA"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="10">
                <Label fx:id="lblAdministracion" text="Administración"
                       style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button fx:id="btnUsuarios" text="Usuarios" onAction="#openUsuarios"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Inventarios"
                       style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button text="Productos" onAction="#openProductos"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>
                <Button text="Validación" onAction="#openValidacion"
                        style="-fx-background-color: #333333; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Pedidos"
                       style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button text="Pedidos" onAction="#openPedidos"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Label text="Ayuda"
                       style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
                <Button text="Acerca de" onAction="#openAyuda"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>

                <Button text="Cerrar sesión" onAction="#logout"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 6 12; -fx-background-radius: 5;"/>
            </VBox>

            <Label fx:id="lblUsuario" text="Usuario"
                   style="-fx-text-fill: #bbbbbb; -fx-font-size: 12px;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #ffffff;">

            <VBox spacing="4">
                <Label text="Validación de Inventarios"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Captura la cantidad física que tienes de cada producto. El sistema detectará sobrantes o faltantes."
                       style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
            </VBox>

            <Label text="✏️  Haz doble clic en la columna 'En físico' para ingresar la cantidad real de cada producto."
                   style="-fx-font-size: 13px; -fx-text-fill: #333333;
                          -fx-background-color: #fff3cd; -fx-padding: 8 12;
                          -fx-background-radius: 5;"/>

            <TableView fx:id="tablaValidacion" prefHeight="420" editable="true">
                <columns>
                    <TableColumn text="Producto"   prefWidth="220"/>
                    <TableColumn text="En sistema" prefWidth="110"/>
                    <TableColumn text="En físico"  prefWidth="110"/>
                    <TableColumn text="Diferencia" prefWidth="100"/>
                    <TableColumn text="Estado"     prefWidth="130"/>
                </columns>
            </TableView>

            <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
                <Label fx:id="lblResumen"
                       text="✅ OK: 0   🔴 Con faltantes: 0   🟡 Con excedentes: 0"
                       style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>

                <Button text="🔄 Recargar" onAction="#recargarDatos"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white;
                               -fx-padding: 8 20; -fx-background-radius: 5; -fx-font-size: 13px;"/>

                <Button fx:id="btnGuardar" text="💾 Guardar validación" onAction="#guardarValidacion"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;
                               -fx-padding: 8 20; -fx-background-radius: 5;
                               -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>